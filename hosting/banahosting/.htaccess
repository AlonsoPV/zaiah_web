Options -MultiViews
RewriteEngine On

# Real 404 document (prerendered).
ErrorDocument 404 /404.html

# Serve existing files and folders directly (robots.txt, sitemap.xml, assets).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Known SPA routes → their prerendered folders / index.
RewriteRule ^(modelo)/?$ /$1/index.html [L]
RewriteRule ^(portafolio)/?$ /$1/index.html [L]
RewriteRule ^(zaiah-health)/?$ /$1/index.html [L]
RewriteRule ^casos-de-exito/edison-58/?$ /casos-de-exito/edison-58/index.html [L]
RewriteRule ^(preguntas-frecuentes)/?$ /$1/index.html [L]
RewriteRule ^(quienes-somos)/?$ /$1/index.html [L]
RewriteRule ^(contacto)/?$ /$1/index.html [L]
RewriteRule ^(gracias)/?$ /$1/index.html [L]
RewriteRule ^(aviso-de-privacidad)/?$ /$1/index.html [L]

# Home
RewriteRule ^$ /index.html [L]

# Anything else → 404
RewriteRule ^ - [R=404,L]

# Basic compression and browser caching for static assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
